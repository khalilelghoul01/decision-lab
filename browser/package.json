{
  "name": "decision-lab-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:upload": "bash scripts/upload-r2-assets.sh",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "ajv": "8.20.0",
    "decision-lab-sdk": "file:../sdk",
    "onnxruntime-web": "1.24.3"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  }
}
