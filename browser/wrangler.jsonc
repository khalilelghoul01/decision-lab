{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decision-lab",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-18",
  "routes": [{ "pattern": "decision-lab.loomens.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/model-v3-q4/*", "/assets/*.wasm"]
  },
  "r2_buckets": [{
    "binding": "MODELS",
    "bucket_name": "decision-lab-models"
  }]
}
